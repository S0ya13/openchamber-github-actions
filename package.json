{
  "name": "github-actions-openchamber",
  "version": "1.0.0",
  "private": true,
  "description": "OpenChamber panel showing GitHub Actions workflow runs for the open project, with re-run and cancel.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run build:panel && bun run build:status && bun run build:service",
    "build:panel": "openchamber-guest-bundle panel/main.ts panel/main.js",
    "build:status": "openchamber-guest-bundle status/main.ts status/main.js",
    "build:service": "openchamber-guest-bundle --node service/main.ts service/main.js",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build && bun test"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.5.3",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.22.0"
    },
    "contributes": {
      "panel": {
        "id": "github-actions",
        "name": "GitHub Actions",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "GitHub Actions",
        "height": 96
      },
      "capabilities": [
        "files",
        "sessions"
      ],
      "filesystem": [
        "/**/.git/config",
        "/**/.git/worktrees/*/HEAD"
      ],
      "integration": {
        "name": "GitHub Actions",
        "description": "Workflow runs of the open project. Paste a GitHub token: classic with the repo scope (shows error annotations), or fine-grained with Actions (read and write) and Metadata (read).",
        "token": {
          "apiOrigin": "https://api.github.com",
          "account": {
            "path": "/user",
            "name": "login"
          },
          "scheme": "bearer"
        },
        "settings": [
          {
            "id": "repository",
            "label": "Repository override (owner/name, optional)"
          }
        ]
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "gh"
          ]
        }
      }
    }
  }
}
